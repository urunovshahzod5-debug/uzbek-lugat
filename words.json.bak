[
  {
    "id": "0001",
    "word": "kitob",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Muqovalangan yoki biriktirilgan varaqlarda matn, tasvir yoxud bilimlar jamlangan nashr; unda bir yoki bir necha mavzu yoritiladi.",
        "examples": [
          "Vali kechqurun qiziqarli kitob o‘qidi.",
          "Bu kitobda biologiyaga oid ma’lumotlar bor.",
          "Kutubxonadan tarix haqidagi kitobni oldim."
        ]
      }
    ]
  },
  {
    "id": "0002",
    "word": "maktab",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "O‘quvchilarga ta’lim va tarbiya beriladigan ta’lim muassasasi.",
        "examples": [
          "Singlim har kuni maktabga boradi.",
          "Maktab kutubxonasida yangi kitoblar bor."
        ]
      }
    ]
  },
  {
    "id": "0003",
    "word": "qalam",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Yozish yoki chizish uchun ishlatiladigan, iz qoldiruvchi o‘zakli asbob.",
        "examples": [
          "Men manzilni qalam bilan yozdim.",
          "Rassom qalamda daraxt rasmini chizdi."
        ]
      }
    ]
  },
  {
    "id": "0004",
    "word": "daftar",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Yozuv va qaydlar uchun varaqlari biriktirilgan kichik kitobcha.",
        "examples": [
          "Dilnoza yangi daftar sotib oldi.",
          "U so‘zlarni daftariga yozib bordi."
        ]
      }
    ]
  },
  {
    "id": "0005",
    "word": "ustoz",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Ta’lim beradigan, bilim va ko‘nikma o‘rgatadigan kishi.",
        "examples": [
          "Ustozimiz yangi mavzuni tushuntirdi.",
          "Men ustozimdan maslahat so‘radim."
        ]
      }
    ]
  },
  {
    "id": "0006",
    "word": "o‘quvchi",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Maktab yoki boshqa ta’lim muassasasida ta’lim olayotgan shaxs.",
        "examples": [
          "O‘quvchi savolga javob berdi.",
          "Har bir o‘quvchi darsga tayyorlandi."
        ]
      }
    ]
  },
  {
    "id": "0007",
    "word": "talaba",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Oliy yoki o‘rta maxsus ta’lim muassasasida tahsil olayotgan shaxs.",
        "examples": [
          "Talaba imtihonga puxta tayyorlandi.",
          "Universitetda talabalar uchun kutubxona bor."
        ]
      }
    ]
  },
  {
    "id": "0008",
    "word": "universitet",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Oliy ta’lim va ilmiy faoliyat olib boriladigan ta’lim muassasasi.",
        "examples": [
          "Akasi universitetda muhandislikni o‘rganadi.",
          "Universitetda ilmiy anjuman bo‘lib o‘tdi."
        ]
      }
    ]
  },
  {
    "id": "0009",
    "word": "dars",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Muayyan fan yoki mavzu bo‘yicha belgilangan vaqtda olib boriladigan ta’lim mashg‘uloti.",
        "examples": [
          "Bugun birinchi dars soat sakkizda boshlandi.",
          "Darsda yangi so‘zlarni o‘rgandik."
        ]
      }
    ]
  },
  {
    "id": "0010",
    "word": "savol",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Javob yoki tushuntirish olish uchun aytiladigan so‘roq mazmunidagi gap yoki murojaat.",
        "examples": [
          "Talaba ustoziga savol berdi.",
          "Savolga aniq javob topdik."
        ]
      }
    ]
  },
  {
    "id": "0011",
    "word": "javob",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Savolga yoki murojaatga qaytarilgan fikr yoki ma’lumot.",
        "examples": [
          "U savolga to‘g‘ri javob berdi.",
          "Javobni daftarimga yozdim."
        ]
      }
    ]
  },
  {
    "id": "0012",
    "word": "so‘z",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Ma’no bildiradigan va nutqda qo‘llanadigan til birligi.",
        "examples": [
          "‘Daraxt’ so‘zi olti harfdan iborat.",
          "Yangi so‘zning ma’nosini lug‘atdan izladim."
        ]
      }
    ]
  },
  {
    "id": "0013",
    "word": "til",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Kishilar o‘zaro fikr almashish uchun ishlatadigan belgilar va qoidalar tizimi.",
        "examples": [
          "O‘zbek tili boy va ifodali.",
          "U koreys tilini o‘rganmoqda."
        ]
      }
    ]
  },
  {
    "id": "0014",
    "word": "lug‘at",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "So‘zlar va ularning ma’nolari yoki tarjimalari tartib bilan jamlangan manba.",
        "examples": [
          "Noma’lum so‘zni lug‘atdan tekshirdim.",
          "Elektron lug‘atda qidiruv tez ishlaydi."
        ]
      }
    ]
  },
  {
    "id": "0015",
    "word": "ma’no",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "So‘z, ibora, belgi yoki gap orqali anglashiladigan mazmun.",
        "examples": [
          "Bu so‘zning ikki ma’nosi bor.",
          "Gapning ma’nosini kontekst yordamida tushundim."
        ]
      }
    ]
  },
  {
    "id": "0016",
    "word": "misol",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Bir qoida, fikr yoki ma’noni tushuntirishga xizmat qiladigan aniq namuna.",
        "examples": [
          "Ustoz yangi qoidaga misol keltirdi.",
          "Lug‘atda har bir ma’noga misol berilgan."
        ]
      }
    ]
  },
  {
    "id": "0017",
    "word": "harf",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Yozuv tizimida nutq tovushini yoki tovushlar birikmasini ifodalovchi belgi.",
        "examples": [
          "‘A’ harfi alifboning boshida keladi.",
          "Bu so‘z beshta harfdan tuzilgan."
        ]
      }
    ]
  },
  {
    "id": "0018",
    "word": "tovush",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Eshitish orqali idrok qilinadigan nutq yoki boshqa manbadan chiqqan akustik hodisa.",
        "examples": [
          "‘Ona’ so‘zida uchta tovush bor.",
          "Deraza ortidan qush tovushi eshitildi."
        ]
      }
    ]
  },
  {
    "id": "0019",
    "word": "bo‘g‘in",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "So‘zning talaffuzda bir zarb bilan aytiladigan qismi.",
        "examples": [
          "‘Oila’ so‘zi uch bo‘g‘inda aytiladi.",
          "U so‘zni bo‘g‘inlarga ajratib o‘qidi."
        ]
      }
    ]
  },
  {
    "id": "0020",
    "word": "gap",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Tugallangan fikrni bildiradigan nutq birligi.",
        "examples": [
          "Har bir gap bosh harf bilan boshlanadi.",
          "U qisqa gap tuzdi."
        ]
      }
    ]
  },
  {
    "id": "0021",
    "word": "matn",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "O‘zaro mazmunan bog‘langan gaplar yoki yozma nutq parchasi.",
        "examples": [
          "O‘quvchi matnni diqqat bilan o‘qidi.",
          "Matnda bahor fasli tasvirlangan."
        ]
      }
    ]
  },
  {
    "id": "0022",
    "word": "ism",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Shaxsga berilgan va uni boshqalardan ajratib ko‘rsatadigan nom.",
        "examples": [
          "Uning ismi Shahzod.",
          "Arizaga ism va familiyangizni yozing."
        ]
      }
    ]
  },
  {
    "id": "0023",
    "word": "odam",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Inson zotiga mansub shaxs.",
        "examples": [
          "Bekatda bir odam avtobus kutib turardi.",
          "Har bir odam dam olishga muhtoj."
        ]
      }
    ]
  },
  {
    "id": "0024",
    "word": "bola",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Yosh, voyaga yetmagan inson.",
        "examples": [
          "Bola hovlida to‘p o‘ynadi.",
          "Bola ertakni qiziqib tingladi."
        ]
      }
    ]
  },
  {
    "id": "0025",
    "word": "oila",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Nikoh yoki qarindoshlik munosabatlari bilan bog‘langan kishilar guruhi.",
        "examples": [
          "Bizning oilamiz dam olish kuni birga ovqatlanadi.",
          "Oila a’zolari bir-biriga yordam berdi."
        ]
      }
    ]
  },
  {
    "id": "0026",
    "word": "do‘st",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "O‘zaro yaqinlik va ishonch asosidagi munosabatdagi kishi.",
        "examples": [
          "Do‘stim menga kitob berdi.",
          "Yaxshi do‘st qiyin paytda yordam beradi."
        ]
      }
    ]
  },
  {
    "id": "0027",
    "word": "ona",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Farzandni dunyoga keltirgan ayol; farzandning onasi.",
        "examples": [
          "Onam menga ertak aytib berdi.",
          "U onasiga telefon qildi."
        ]
      }
    ]
  },
  {
    "id": "0028",
    "word": "ota",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Farzandning erkak ota-onasi.",
        "examples": [
          "Otam bog‘da daraxt ekdi.",
          "U otasi bilan bozorga bordi."
        ]
      }
    ]
  },
  {
    "id": "0029",
    "word": "aka",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "O‘zidan katta bo‘lgan erkak tug‘ishgan yoki yaqin qarindosh.",
        "examples": [
          "Akam universitetda o‘qiydi.",
          "Aka singlisiga yo‘lni ko‘rsatdi."
        ]
      }
    ]
  },
  {
    "id": "0030",
    "word": "singil",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Qiz bolaning o‘zidan kichik ayol tug‘ishgan qarindoshi.",
        "examples": [
          "Singlim rasm chizishni yaxshi ko‘radi.",
          "Men singlimga daftar sovg‘a qildim."
        ]
      }
    ]
  },
  {
    "id": "0031",
    "word": "uy",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Odamlar yashashi uchun mo‘ljallangan bino yoki turar joy.",
        "examples": [
          "Bizning uyimiz maktabga yaqin.",
          "U ishdan keyin uyga qaytdi."
        ]
      }
    ]
  },
  {
    "id": "0032",
    "word": "xona",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Bino ichidagi devorlar bilan ajratilgan alohida joy.",
        "examples": [
          "Xonamda stol va kitob javoni bor.",
          "Mehmonlar katta xonada o‘tirishdi."
        ]
      }
    ]
  },
  {
    "id": "0033",
    "word": "eshik",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Xonaga yoki binoga kirib-chiqish uchun ochilib-yopiladigan to‘siq.",
        "examples": [
          "Mehmon eshikni taqillatdi.",
          "Iltimos, eshikni yopib qo‘ying."
        ]
      }
    ]
  },
  {
    "id": "0034",
    "word": "deraza",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Xonaga yorug‘lik va havo kirishi uchun devorga o‘rnatilgan ochiladigan qism.",
        "examples": [
          "Derazadan quyosh nuri tushdi.",
          "U derazani ochib, xonani shamollatdi."
        ]
      }
    ]
  },
  {
    "id": "0035",
    "word": "stol",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Yozish, ovqatlanish yoki buyum qo‘yish uchun mo‘ljallangan oyoqli mebel.",
        "examples": [
          "Kitob stol ustida turibdi.",
          "U kompyuterini stolga qo‘ydi."
        ]
      }
    ]
  },
  {
    "id": "0036",
    "word": "stul",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Bir kishining o‘tirishi uchun mo‘ljallangan suyanchiqli yoki suyanchiqsiz mebel.",
        "examples": [
          "Mehmon stulga o‘tirdi.",
          "Stulni deraza yoniga olib bordim."
        ]
      }
    ]
  },
  {
    "id": "0037",
    "word": "suv",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Rangsiz, hidsiz suyuqlik; tirik organizmlar hayoti uchun zarur modda.",
        "examples": [
          "Issiq kunda ko‘proq suv iching.",
          "O‘simlikka suv quydim."
        ]
      }
    ]
  },
  {
    "id": "0038",
    "word": "non",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Odatda xamirdan pishiriladigan, ko‘p joyda asosiy oziq sifatida iste’mol qilinadigan mahsulot.",
        "examples": [
          "Nonushtaga yangi non oldik.",
          "U nonni dasturxonga qo‘ydi."
        ]
      }
    ]
  },
  {
    "id": "0039",
    "word": "ovqat",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Odam yoki hayvon iste’mol qiladigan oziq; taom.",
        "examples": [
          "Onam kechki ovqat tayyorladi.",
          "Ovqat sovib qolmasidan dasturxonga o‘tiring."
        ]
      }
    ]
  },
  {
    "id": "0040",
    "word": "choy",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Choy o‘simligi barglaridan damlanadigan ichimlik; ayrim joylarda shu ichimlikning o‘zi.",
        "examples": [
          "Mehmonlarga issiq choy quyildi.",
          "Men ertalab choy ichaman."
        ]
      }
    ]
  },
  {
    "id": "0041",
    "word": "meva",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "O‘simlikda hosil bo‘ladigan, ko‘pincha yeyiladigan urug‘li mahsulot.",
        "examples": [
          "Bozordan yangi meva sotib oldik.",
          "Olma foydali mevalardan biridir."
        ]
      }
    ]
  },
  {
    "id": "0042",
    "word": "olma",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Daraxtda o‘sadigan, odatda dumaloq va shirali iste’mol mevasi.",
        "examples": [
          "U tushlikdan keyin bitta olma yedi.",
          "Bog‘imizdagi olma daraxti hosil berdi."
        ]
      }
    ]
  },
  {
    "id": "0043",
    "word": "daraxt",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Tanasi yog‘ochlashgan, shox va barg chiqaradigan ko‘p yillik o‘simlik.",
        "examples": [
          "Hovliga yosh daraxt ekdik.",
          "Daraxt soyasida dam oldik."
        ]
      }
    ]
  },
  {
    "id": "0044",
    "word": "gul",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "O‘simlikning urug‘ hosil qilishda qatnashadigan rangli yoki xushbo‘y qismi.",
        "examples": [
          "U onasiga bir dasta gul berdi.",
          "Bahorda bog‘dagi gullar ochildi."
        ]
      }
    ]
  },
  {
    "id": "0045",
    "word": "hayvon",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Oziqlanadigan, nafas oladigan va odatda harakatlana oladigan tirik mavjudot.",
        "examples": [
          "Hayvonot bog‘ida turli hayvonlarni ko‘rdik.",
          "Har bir hayvonga suv kerak."
        ]
      }
    ]
  },
  {
    "id": "0046",
    "word": "qush",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Pat va qanotga ega, tumshug‘i bilan oziqlanadigan hayvon.",
        "examples": [
          "Qush daraxt shoxiga qo‘ndi.",
          "Ertalab qushlarning sayrashini eshitdik."
        ]
      }
    ]
  },
  {
    "id": "0047",
    "word": "mushuk",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Ko‘pincha uyda boqiladigan, mo‘ylovli va chaqqon sutemizuvchi hayvon.",
        "examples": [
          "Mushuk deraza yonida uxlab yotibdi.",
          "U mushukka sut emas, suv berdi."
        ]
      }
    ]
  },
  {
    "id": "0048",
    "word": "it",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Uy va mol-mulkni qo‘riqlash yoki hamroh bo‘lish uchun boqiladigan uy hayvoni.",
        "examples": [
          "It hovlida yugurdi.",
          "Ularning iti begonalarga vovulladi."
        ]
      }
    ]
  },
  {
    "id": "0049",
    "word": "kun",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Yerning o‘z o‘qi atrofida aylanishiga bog‘liq 24 soatlik vaqt birligi; kunduzgi vaqt.",
        "examples": [
          "Bir kun ichida topshiriqni tugatdim.",
          "Bugun kun juda issiq."
        ]
      }
    ]
  },
  {
    "id": "0050",
    "word": "tun",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Quyosh botganidan chiqqunigacha bo‘lgan qorong‘i vaqt.",
        "examples": [
          "Tun yarmida yomg‘ir yog‘a boshladi.",
          "U tun bo‘yi kitob o‘qidi."
        ]
      }
    ]
  },
  {
    "id": "0051",
    "word": "vaqt",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Voqealar davom etishi va ketma-ketligini ifodalovchi o‘lchov; muayyan payt yoki muddat.",
        "examples": [
          "Dars boshlanish vaqtini tekshirdim.",
          "Vaqtni tejash uchun avtobusga chiqdik."
        ]
      }
    ]
  },
  {
    "id": "0052",
    "word": "yil",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Taxminan o‘n ikki oydan iborat vaqt birligi.",
        "examples": [
          "U bir yil davomida koreys tilini o‘rgandi.",
          "Yangi yil yanvar oyida boshlanadi."
        ]
      }
    ]
  },
  {
    "id": "0053",
    "word": "hafta",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Yetti kundan iborat vaqt birligi.",
        "examples": [
          "Haftada besh kun darsga boraman.",
          "Keyingi hafta imtihon boshlanadi."
        ]
      }
    ]
  },
  {
    "id": "0054",
    "word": "kunlik",
    "partOfSpeech": "sifat",
    "meanings": [
      {
        "definition": "Bir kun davomida bo‘ladigan yoki har kuni bajariladigan.",
        "examples": [
          "U kunlik rejasini daftariga yozdi.",
          "Kunlik mashq qilish foydali."
        ]
      }
    ]
  },
  {
    "id": "0055",
    "word": "bugun",
    "partOfSpeech": "ravish",
    "meanings": [
      {
        "definition": "Hozirgi kunni bildiradigan vaqt ravishi.",
        "examples": [
          "Bugun kutubxonaga boraman.",
          "Bugun havo salqin."
        ]
      }
    ]
  },
  {
    "id": "0056",
    "word": "ertaga",
    "partOfSpeech": "ravish",
    "meanings": [
      {
        "definition": "Bugundan keyingi kunni bildiradigan vaqt ravishi.",
        "examples": [
          "Ertaga yangi dars boshlanadi.",
          "Biz ertaga uchrashamiz."
        ]
      }
    ]
  },
  {
    "id": "0057",
    "word": "kecha",
    "partOfSpeech": "ravish",
    "meanings": [
      {
        "definition": "Bugundan oldingi kunni bildiradigan vaqt ravishi.",
        "examples": [
          "Kecha yomg‘ir yog‘di.",
          "Men kecha yangi so‘zlarni takrorladim."
        ]
      }
    ]
  },
  {
    "id": "0058",
    "word": "ertalab",
    "partOfSpeech": "ravish",
    "meanings": [
      {
        "definition": "Kun boshlanishidagi, tongdan tushgacha bo‘lgan paytda.",
        "examples": [
          "Ertalab avtobusda universitetga bordim.",
          "U ertalab nonushta qildi."
        ]
      }
    ]
  },
  {
    "id": "0059",
    "word": "kechqurun",
    "partOfSpeech": "ravish",
    "meanings": [
      {
        "definition": "Kunning oxiriga yaqin, quyosh botishi atrofidagi vaqtda.",
        "examples": [
          "Kechqurun oilamiz bilan sayr qildik.",
          "U kechqurun dars tayyorlaydi."
        ]
      }
    ]
  },
  {
    "id": "0060",
    "word": "bor",
    "partOfSpeech": "sifat",
    "meanings": [
      {
        "definition": "Mavjud yoki qo‘l ostida ekanini bildiradi.",
        "examples": [
          "Uyda sut bor.",
          "Menda bu kitobning eski nusxasi bor."
        ]
      }
    ]
  },
  {
    "id": "0061",
    "word": "yo‘q",
    "partOfSpeech": "so‘z",
    "meanings": [
      {
        "definition": "Mavjud emaslikni yoki biror narsaning yo‘qligini bildiradi.",
        "examples": [
          "Bugun dars yo‘q.",
          "Stolda qalam yo‘q."
        ]
      }
    ]
  },
  {
    "id": "0062",
    "word": "katta",
    "partOfSpeech": "sifat",
    "meanings": [
      {
        "definition": "Hajmi, miqdori, yoshi yoki ahamiyati jihatidan odatdagidan yuqori bo‘lgan.",
        "examples": [
          "U katta xonada ishlaydi.",
          "Katta daraxt yo‘l chetida o‘sib turibdi."
        ]
      }
    ]
  },
  {
    "id": "0063",
    "word": "kichik",
    "partOfSpeech": "sifat",
    "meanings": [
      {
        "definition": "Hajmi, miqdori yoki yoshi jihatidan katta bo‘lmagan.",
        "examples": [
          "Kichik bola rangli qalam oldi.",
          "Biz kichik do‘kondan non sotib oldik."
        ]
      }
    ]
  },
  {
    "id": "0064",
    "word": "yaxshi",
    "partOfSpeech": "sifat",
    "meanings": [
      {
        "definition": "Ijobiy bahoga loyiq, foydali yoki ma’qul bo‘lgan.",
        "examples": [
          "U yaxshi savol berdi.",
          "Bugun o‘zimni yaxshi his qilyapman."
        ]
      }
    ]
  },
  {
    "id": "0065",
    "word": "yomon",
    "partOfSpeech": "sifat",
    "meanings": [
      {
        "definition": "Salbiy baholanadigan, zararli yoki ma’qul bo‘lmagan.",
        "examples": [
          "Yomon ob-havo sababli sayr qoldirildi.",
          "Boshqalarga yomon muomala qilma."
        ]
      }
    ]
  },
  {
    "id": "0066",
    "word": "yangi",
    "partOfSpeech": "sifat",
    "meanings": [
      {
        "definition": "Yaqinda yaratilgan, olingan yoki paydo bo‘lgan; eskirmagan.",
        "examples": [
          "Men yangi daftar sotib oldim.",
          "U yangi mavzuni o‘rgandi."
        ]
      }
    ]
  },
  {
    "id": "0067",
    "word": "eski",
    "partOfSpeech": "sifat",
    "meanings": [
      {
        "definition": "Ancha vaqtdan beri mavjud yoki ishlatilgan; yangi bo‘lmagan.",
        "examples": [
          "Eski suratlarni albomga joyladik.",
          "Bu eski ko‘prik ta’mirlandi."
        ]
      }
    ]
  },
  {
    "id": "0068",
    "word": "issiq",
    "partOfSpeech": "sifat",
    "meanings": [
      {
        "definition": "Harorati yuqori bo‘lgan; tanaga iliq yoki qaynoq seziladigan.",
        "examples": [
          "Issiq choyni ehtiyotkorlik bilan ich.",
          "Yozda havo issiq bo‘ladi."
        ]
      }
    ]
  },
  {
    "id": "0069",
    "word": "sovuq",
    "partOfSpeech": "sifat",
    "meanings": [
      {
        "definition": "Harorati past bo‘lgan; tanaga salqin yoki muzdek seziladigan.",
        "examples": [
          "Tashqarida sovuq shamol esmoqda.",
          "Sovuq suvni muzlatkichga qo‘ydim."
        ]
      }
    ]
  },
  {
    "id": "0070",
    "word": "tez",
    "partOfSpeech": "ravish",
    "meanings": [
      {
        "definition": "Katta tezlikda yoki qisqa vaqt ichida.",
        "examples": [
          "Avtobus bekatga tez yetib keldi.",
          "U savolga tez javob berdi."
        ]
      }
    ]
  },
  {
    "id": "0071",
    "word": "sekin",
    "partOfSpeech": "ravish",
    "meanings": [
      {
        "definition": "Shoshilmay, past tezlikda.",
        "examples": [
          "Iltimos, sekinroq gapiring.",
          "Mashina tor ko‘chada sekin yurdi."
        ]
      }
    ]
  },
  {
    "id": "0072",
    "word": "chiroyli",
    "partOfSpeech": "sifat",
    "meanings": [
      {
        "definition": "Ko‘rkam ko‘rinishga yoki yoqimli shaklga ega.",
        "examples": [
          "Bog‘da chiroyli gullar ochildi.",
          "U chiroyli rasm chizdi."
        ]
      }
    ]
  },
  {
    "id": "0073",
    "word": "aqlli",
    "partOfSpeech": "sifat",
    "meanings": [
      {
        "definition": "Yaxshi fikrlash va anglash qobiliyatiga ega.",
        "examples": [
          "Aqlli bola muammoni o‘zi hal qildi.",
          "U aqlli savol bilan suhbatni boshladi."
        ]
      }
    ]
  },
  {
    "id": "0074",
    "word": "o‘qimoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Yozuv yoki matn belgilarini ko‘z bilan kuzatib, mazmunini anglamoq; ta’lim olmoq.",
        "examples": [
          "Men har kuni kechqurun kitob o‘qiyman.",
          "U universitetda iqtisod yo‘nalishida o‘qiydi."
        ]
      }
    ]
  },
  {
    "id": "0075",
    "word": "yozmoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Harf yoki belgilar yordamida fikrni qog‘ozda yoki elektron shaklda ifodalamoq.",
        "examples": [
          "U xatni daftariga yozdi.",
          "Men ustozimga elektron pochta yozdim."
        ]
      }
    ]
  },
  {
    "id": "0076",
    "word": "gapirmoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "So‘zlar orqali fikr yoki xabarni og‘zaki ifodalamoq.",
        "examples": [
          "U o‘zbek tilida ravon gapiradi.",
          "Majlisda navbat bilan gapiring."
        ]
      }
    ]
  },
  {
    "id": "0077",
    "word": "tinglamoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Eshitishga diqqat qaratmoq; aytilgan gap yoki tovushni qabul qilmoq.",
        "examples": [
          "Talabalar ustozni diqqat bilan tinglashdi.",
          "Men yo‘lda musiqa tingladim."
        ]
      }
    ]
  },
  {
    "id": "0078",
    "word": "ko‘rmoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Ko‘z bilan idrok etmoq; tomosha yoki kuzatish orqali bilmoq.",
        "examples": [
          "Men osmondagi kamalakni ko‘rdim.",
          "U kechqurun film ko‘rdi."
        ]
      }
    ]
  },
  {
    "id": "0079",
    "word": "bilmoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Ma’lumot yoki ko‘nikmaga ega bo‘lmoq; biror narsani anglamoq.",
        "examples": [
          "U bu so‘zning ma’nosini biladi.",
          "Men avtobus yo‘nalishini bilmayman."
        ]
      }
    ]
  },
  {
    "id": "0080",
    "word": "o‘rganmoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Bilim yoki ko‘nikmani mashq va ta’lim orqali egallamoq.",
        "examples": [
          "Men yangi dasturlash tilini o‘rganyapman.",
          "U har kuni o‘nta yangi so‘z o‘rganadi."
        ]
      }
    ]
  },
  {
    "id": "0081",
    "word": "ishlamoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Mehnat yoki vazifani bajarmoq; biror ish bilan shug‘ullanmoq.",
        "examples": [
          "Onam shifoxonada ishlaydi.",
          "Kompyuterim hozir to‘g‘ri ishlayapti."
        ]
      }
    ]
  },
  {
    "id": "0082",
    "word": "yurmoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Oyoqlar yordamida qadam tashlab harakatlanmoq; piyoda bormoq.",
        "examples": [
          "Men uyga piyoda yurdim.",
          "U parkda yarim soat yurdi."
        ]
      }
    ]
  },
  {
    "id": "0083",
    "word": "kelmoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Gapiruvchiga yoki ko‘rsatilgan joyga qarab harakatlanmoq.",
        "examples": [
          "Do‘stim bugun mehmon bo‘lib keldi.",
          "Avtobus bekatga vaqtida keldi."
        ]
      }
    ]
  },
  {
    "id": "0084",
    "word": "bormoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Bir joydan boshqa joyga qarab yo‘l olmoq.",
        "examples": [
          "Biz ertalab kutubxonaga bordik.",
          "U darsdan keyin uyiga boradi."
        ]
      }
    ]
  },
  {
    "id": "0085",
    "word": "olmoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Biror narsani qo‘lga kiritmoq yoki o‘ziga qabul qilmoq.",
        "examples": [
          "Men do‘kondan daftar oldim.",
          "U kutubxonadan kitob oldi."
        ]
      }
    ]
  },
  {
    "id": "0086",
    "word": "bermoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Biror narsani boshqa kishiga topshirmoq yoki taqdim etmoq.",
        "examples": [
          "U singlisiga qalam berdi.",
          "Ustoz talabaga foydali maslahat berdi."
        ]
      }
    ]
  },
  {
    "id": "0087",
    "word": "yemoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Oziqni og‘izga olib chaynab yutmoq.",
        "examples": [
          "Bola olma yedi.",
          "Biz tushlikda sho‘rva yedik."
        ]
      }
    ]
  },
  {
    "id": "0088",
    "word": "ichmoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Suyuqlikni og‘iz orqali yutmoq.",
        "examples": [
          "U bir stakan suv ichdi.",
          "Men ertalab choy ichaman."
        ]
      }
    ]
  },
  {
    "id": "0089",
    "word": "uxlamoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Uyqu holatiga tushmoq yoki dam olish uchun ko‘zni yumib yotmoq.",
        "examples": [
          "Charchagan bola erta uxladi.",
          "Men kecha sakkiz soat uxladim."
        ]
      }
    ]
  },
  {
    "id": "0090",
    "word": "o‘ynamoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "O‘yin yoki hordiq mashg‘ulotida qatnashmoq.",
        "examples": [
          "Bolalar hovlida to‘p o‘ynashdi.",
          "U bo‘sh vaqtida shaxmat o‘ynaydi."
        ]
      }
    ]
  },
  {
    "id": "0091",
    "word": "ochmoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Yopiq narsani ochiq holatga keltirmoq; kirish yoki ko‘rish imkonini bermoq.",
        "examples": [
          "Iltimos, derazani oching.",
          "U kitobni birinchi sahifasidan ochdi."
        ]
      }
    ]
  },
  {
    "id": "0092",
    "word": "yopmoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Ochiq narsani berkitmoq yoki kirishni to‘smoq.",
        "examples": [
          "U eshikni sekin yopdi.",
          "Do‘kon kechqurun soat to‘qqizda yopiladi."
        ]
      }
    ]
  },
  {
    "id": "0093",
    "word": "boshlamoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Ish yoki harakatni boshlang‘ich nuqtasidan amalga oshirishga kirishmoq.",
        "examples": [
          "Dars soat to‘qqizda boshlanadi.",
          "U yangi kitobni o‘qishni boshladi."
        ]
      }
    ]
  },
  {
    "id": "0094",
    "word": "tugatmoq",
    "partOfSpeech": "fe’l",
    "meanings": [
      {
        "definition": "Boshlangan ish yoki jarayonni oxiriga yetkazmoq.",
        "examples": [
          "Men uy vazifamni tugatdim.",
          "Ular ta’mirlash ishini bugun tugatishdi."
        ]
      }
    ]
  },
  {
    "id": "0095",
    "word": "yordam",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Biror ishni bajarishda yoki qiyinchilikni yengishda ko‘rsatiladigan ko‘mak.",
        "examples": [
          "Do‘stim menga kompyuterni sozlashda yordam berdi.",
          "Yordam kerak bo‘lsa, ustozga murojaat qiling."
        ]
      }
    ]
  },
  {
    "id": "0096",
    "word": "ish",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Maqsadga erishish uchun bajariladigan mehnat, vazifa yoki faoliyat.",
        "examples": [
          "U ishini vaqtida tugatdi.",
          "Bu ish uchun ko‘proq vaqt kerak."
        ]
      }
    ]
  },
  {
    "id": "0097",
    "word": "pul",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Tovar va xizmatlar qiymatini to‘lashda ishlatiladigan ayirboshlash vositasi.",
        "examples": [
          "Men yo‘l haqi uchun pul tayyorladim.",
          "U pulini hamyonida saqlaydi."
        ]
      }
    ]
  },
  {
    "id": "0098",
    "word": "bozor",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Tovarlar sotiladigan va xarid qilinadigan savdo joyi.",
        "examples": [
          "Onam bozordan sabzavot oldi.",
          "Bozor ertalab gavjum bo‘ladi."
        ]
      }
    ]
  },
  {
    "id": "0099",
    "word": "do‘kon",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Tovarlar sotiladigan savdo xonasi yoki kichik savdo korxonasi.",
        "examples": [
          "Uyimiz yonida oziq-ovqat do‘koni bor.",
          "U do‘kondan sut sotib oldi."
        ]
      }
    ]
  },
  {
    "id": "0100",
    "word": "shahar",
    "partOfSpeech": "ot",
    "meanings": [
      {
        "definition": "Aholisi ko‘p, binolari va xizmatlari rivojlangan yirik aholi punkti.",
        "examples": [
          "Seul katta va gavjum shahar.",
          "Ular boshqa shaharga ko‘chib ketishdi."
        ]
      }
    ]
  }
]